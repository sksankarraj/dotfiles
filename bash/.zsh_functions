# Open a tmux session with cursor agent in the workspace
# Uses zoxide for directory resolution, same as opin
copin() {
  [[ -z "$1" ]] && { echo "Usage: copin <directory>"; return 1 }

  local target="$1"
  local dir

  if [[ "$target" == "." ]]; then
    dir="$PWD"
  else
    dir=$(zoxide query "$target" 2>/dev/null) || {
      echo "Nothin, Mudin"
      return 1
    }
  fi

  cd "$dir" || return 1

  local session="ca_${dir:t}"
  session=${session//[^a-zA-Z0-9_]/_}

  if ! tmux has-session -t "$session" 2>/dev/null; then
    tmux new-session -d -s "$session" -c "$dir"
    tmux send-keys -t "$session" 'cursor agent' C-m
  fi

  if [[ -n "$TMUX" ]]; then
    tmux switch-client -t "$session"
  else
    tmux attach -t "$session"
  fi
}

# Pipe a file into cursor agent for quick Q&A
# Usage: cask <file> "explain this function"
cask() {
  [[ -z "$1" || -z "$2" ]] && { echo "Usage: cask <file> <prompt>"; return 1 }
  cat "$1" | cursor agent --print --mode=ask "$2"
}

# Get DB vars from pass
generate_db_env() {
  DATABASE_URL="$(pass db/stg)"

  url_no_proto="${DATABASE_URL#postgresql://}"

  user_pass="${url_no_proto%@*}"
  DB_USER="${user_pass%%:*}"
  DB_PASSWORD="${user_pass#*:}"

  host_port_db="${url_no_proto#*@}"

  host_port="${host_port_db%%/*}"
  DB_HOST="${host_port%%:*}"
  DB_PORT="${host_port#*:}"

  db_with_params="${host_port_db#*/}"
  DB_NAME="${db_with_params%%\?*}"
}

# Load DB vars into cache file and source it.
load_db_env() {
  DB_ENV_CACHE="$HOME/.db_env_cache"
  if [ -f "$DB_ENV_CACHE" ]; then
    source "$DB_ENV_CACHE"
  else
    echo "Generating DB env..."

    generate_db_env

    cat > "$DB_ENV_CACHE" <<EOF
export COMPOSE_BAKE=true
export DB_USER="$DB_USER"
export DB_PASSWORD="$DB_PASSWORD"
export DB_HOST="$DB_HOST"
export DB_PORT="$DB_PORT"
export DB_NAME="$DB_NAME"
EOF

    source "$DB_ENV_CACHE"
  fi
}

load_db_env
