# This function will ssh into kube server using kubectl
#
# Usage:
# kube-ssh <namespace> <env>

declare -A envs

envs=(
  [sb]="sandbox,0"
  [sb-01]="sandbox-01,5433"
  [sb-02]="sandbox-02,5434"
  [sb-03]="sandbox-03,5435"
  [sb-04]="sandbox-04,5436"
  [sb-05]="sandbox-05,5437"
  [sb-06]="sandbox-06,5438"
  [sb-07]="sandbox-07,5439"
  [sb-08]="sandbox-08,5440"
  [sb-09]="sandbox-09,5441"
  [stg]="staging,5432"
  [prd]="production,5432"
)

kex() {
  if [ -z "$1" ] || [ -z "$2" ]; then
    echo "Usage: kube-ssh <namespace> <env>"
    return 1
  fi
  
  if [ -z "${envs[$2]}" ]; then
    echo "Invalid environment"
    return 1
  fi

  local env=$(echo "${envs[$2]}" | cut -d "," -f 1)
  tsh kube login flow-${env}-eks-cluster
  export KUBECONFIG=~/.kube/${env}.yaml
  kubectl exec -it -n $1 $(kubectl get pods -n $1 --selector=app.kubernetes.io/name=$1-${env} --field-selector=status.phase==Running -o jsonpath="{.items[0].metadata.name}") -- /bin/bash
}


# This function will cd via zoxide and open a tmux session, then vi into the directory

# Usage:
#
# opin <directory>

opin() {
  if [ -z "$1" ]; then
    echo "Usage: opin <directory>"
    return 1
  fi

  if zoxide query $1 > /dev/null 2>&1; then
    z $1
    tn -d -s $1
    ta $1 \; send-keys 'nvim' C-m
  else
    echo "Nothin, Mudin"
  fi
}

