#!/bin/bash
# This is a collection of functions that I use in my zshrc file.
#
# To use these functions, you can source this file in your zshrc file.
#
# Example:
# source ~/.zsh_functions


declare -A envs

envs=(
  [sb]="sb,0"
  [sb-01]="sb-01,5433"
  [sb-02]="sb-02,5434"
  [sb-03]="sb-03,5435"
  [sb-04]="sb-04,5436"
  [sb-05]="sb-05,5437"
  [sb-06]="sb-06,5438"
  [sb-07]="sb-07,5439"
  [sb-08]="sb-08,5440"
  [sb-09]="sb-09,5441"
  [stg]="staging,5432"
  [prod]="production,5432"
  [im_stg]="instance,5532"
  [im_sb]="instance,5534"
)


# This function will retrieve the secret from keychain
#
# usage:
# get_pw <secret-name>
get_pw() {
  security find-generic-password -ga "$1" -w
}

# This function will login to the kubernetes cluster using tsh
#
# Usage:
# login-tsh <env>
login-tsh() {
  if [ -z "${envs[$1]}" ]; then
    echo "Invalid environment"
    return 1
  fi

  local env=$(echo "${envs[$1]}" | cut -d "," -f 1)
  if tsh kube ls | grep "*" | grep -q "flow-${env}-eks-cluster"; then
    echo "Already logged in to flow-${env}-eks-cluster"
  else
    tsh kube login flow-${env}-eks-cluster
  fi
}


# This function will ssh into kube server using kubectl
#
# Usage:
# kex <namespace> <env>
kex() {
  if [ -z "$1" ] || [ -z "$2" ]; then
    echo "Usage: kex <namespace> <env>"
    return 1
  fi

  login-tsh $2
  
  # Check if the pod is running, if not print error
  local ns=$1
  if [ "$2" = "sb" ]; then
    ns="sb-$1"
  fi
  local env=$(echo "${envs[$2]}" | cut -d "," -f 1)
  local pod=$(kubectl get pods -n $ns --selector=app.kubernetes.io/name=$1-${env} --field-selector=status.phase==Running -o jsonpath="{.items[0].metadata.name}" 2>/dev/null)
  if [ -z "$pod" ]; then
    echo "\033[0;31mError:\033[0m No running pods found for $1 in $env"
    return 1
  fi

  kubectl exec -it -n $ns $pod -- /bin/bash
}


# This function will get logs from kube server using kubectl
#
# Usage:
# klogs <namespace> <env>
klogs() {
  if [ -z "$1" ] || [ -z "$2" ]; then
    echo "Usage: klogs <namespace> <env>"
    return 1
  fi

  login-tsh $2
  
  # Check if the pod is running, if not print error
  local ns=$1
  if [ "$2" = "sb" ]; then
    ns="sb-$1"
  fi
  local env=$(echo "${envs[$2]}" | cut -d "," -f 1)
  local pod=$(kubectl get pods -n $ns --selector=app.kubernetes.io/name=$1-${env} --field-selector=status.phase==Running -o jsonpath="{.items[0].metadata.name}" 2>/dev/null)
  if [ -z "$pod" ]; then
    echo "\033[0;31mError:\033[0m No running pods found for $1 in $env"
    return 1
  fi

  kubectl logs --tail 20 -f -n $ns $pod
}
# This function will cd via zoxide and open a tmux session, then vi into the directory

# Usage:
#
# opin <directory>

opin() {
  [[ -z "$1" ]] && { echo "Usage: opin <directory>"; return 1 }

  local target="$1"
  local dir
  local session

  if [[ "$target" == "." ]]; then
    dir="$PWD"
  else
    dir=$(zoxide query "$target" 2>/dev/null) || {
      echo "Nothin, Mudin"
      return 1
    }
  fi

  cd "$dir" || return 1

  session=${dir:t}
  session=${session//[^a-zA-Z0-9]/_}

  if ! tmux has-session -t "$session" 2>/dev/null; then
    tmux new-session -d -s "$session" -c "$dir"
    tmux send-keys -t "$session" 'nvim' C-m
  fi

  if [[ -n "$TMUX" ]]; then
    tmux switch-client -t "$session"
  else
    tmux attach -t "$session"
  fi
}

# This function will check which process is running on the port given
#
# Usage: port <port number>

port() {

  if [ -z "$1" ]; then
    echo "Usage: port <env>"
    return 1
  fi
  
  lsof -i :$1
}


# This function will check which process is running on the port given and kill it
#
# Usage: port <port number>

kport() {
    PORT=$1
    if [ -z "$PORT" ]; then
        echo "Usage: kill_port <port_number>"
        return 1
    fi

    PID=$(lsof -t -i :$PORT)
    if [ -n "$PID" ]; then
        echo "Killing process $PID on port $PORT..."
        kill -9 $PID && echo "Port $PORT has been freed."
    else
        echo "No process found on port $PORT."
    fi

    # Verify the port is free
    if lsof -i :$PORT; then
        echo "Warning: Port $PORT is still in use. Additional cleanup may be required."
    else
        echo "Port $PORT is completely free."
    fi
}

# This function will ssh into the jump box using tsh and then login to the DB instance using psql
#
# Usage:
#
# db <env>

db() {
  if [ -z "$1" ]; then
    echo "Usage: db <env>"
    return 1
  fi

  local db_url=$(pass db/${1})
  local env=$(echo ${envs[$1]} | cut -d "," -f 1)
  local db_port=$(echo ${envs[$1]} | cut -d "," -f 2)
  
  echo "Connecting to ${env} database..."


  # Ensure the port is free
  echo "Checking if port ${db_port} is free, if not killing the process using it..."
  kport ${db_port} > /dev/null 2>&1

  pgcli ${db_url}
}

# This function is decode jWT tokens in terminal and print the output in a readable format
#
# Usage:
# jwt <token>

jwt() {
  if [ -z "$1" ]; then
    echo "Usage: jwt <token>"
    return 1
  fi

  echo $1 | tr '.' '\n' | awk '{print $0}' | while read line; do
    echo $line | base64 --decode
  done
}

# List open PRs created in the last 48 hours across all repos in a GitHub org
#
# Usage:
# ghprs <org>
ghprs() {
  if [ -z "$1" ]; then
    echo "Usage: ghprs <org>"
    return 1
  fi

  local org="$1"
  local since=$(date -u -v-48H +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || date -u -d "48 hours ago" +"%Y-%m-%dT%H:%M:%SZ")

  printf "\033[1;36mOpen PRs in '%s' from the last 48 hours\033[0m\n" "$org"
  echo "─────────────────────────────────────────────────"

  local result
  result=$(gh search prs \
    --owner "$org" \
    --state open \
    --created ">=$since" \
    --sort created \
    --order desc \
    --limit 100 \
    --json title,repository,author,createdAt,url,isDraft \
    --jq '[.[] | select(.isDraft == false)] | .[] | [.title, (.repository.nameWithOwner // .repository.name), .author.login, .createdAt, .url] | @tsv')

  if [ $? -ne 0 ]; then
    printf "\033[0;31mError:\033[0m Failed to fetch PRs. Ensure you're authenticated (gh auth status) and the org name is correct.\n"
    return 1
  fi

  if [ -z "$result" ]; then
    echo "No open PRs found in the last 48 hours."
    return 0
  fi

  echo "$result" | while IFS=$'\t' read -r title repo author created url; do
    printf "\n\033[1;33m%s\033[0m\n" "$title"
    printf "  Repo:    %s\n" "$repo"
    printf "  Author:  %s\n" "$author"
    printf "  Created: %s\n" "$created"
    printf "  URL:     %s\n" "$url"
  done
}


