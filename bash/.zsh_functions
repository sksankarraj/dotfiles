    echo "Usage: db <env>"
    return 1
  fi

  local env=$(echo ${envs[$1]} | cut -d "," -f 1)
  if [[ $1 == "sb"* ]]; then
    env="sandbox"
  fi

  local db_port=$(echo ${envs[$1]} | cut -d "," -f 2)
  local db_pass=$(get_pw DPBWD)
  local db_user=$(get_pw DUBSR)
  local db_name="flow_${env}"
  local suffix=$1

  if tmux has-session -t "tsh-db-$1" 2>/dev/null; then
    echo "ho"
    tmux kill-session -t "tsh-db-$1"
  fi
  tmux new-session -d -s "tsh-db-$1" "tsh-stg"
      echo "hola"
  export PGPASSWORD=${db_pass}
  psql -h 0.0.0.0 -p ${db_port} -U${db_user} ${db_name}
