}


# This function will check which process is running on the port given
#
# Usage: port <port number>

port() {

  if [ -z "$1" ]; then
    echo "Usage: port <env>"
    return 1
  fi
  
  lsof -i :$1
}


# This function will check which process is running on the port given and kill it
#
# Usage: port <port number>

kport() {

  if [ -z "$1" ]; then
    echo "Usage: port <env>"
    return 1
  fi
  
  PORT=$1

  # Find the PID using lsof
  PID=$(lsof -t -i :$PORT)

  # Check if a PID was found
  if [ -z "$PID" ]; then
      echo "No process found on port $PORT."
  else
      # Kill the process
      kill -9 $PID
      echo "Process with PID $PID on port $PORT has been killed."
  fi
}

# This function will ssh into the jump box using tsh and then login to the DB instance using psql
#
# Usage:
#
# db <env>

db() {

