# Docker
alias dk='docker'
alias dkb='docker build'
alias dke='docker exec'
alias dkE='docker exec -e COLUMNS=`tput cols` -e LINES=`tput lines` -i -t'
alias dkh='docker history'
alias dki='docker images'
alias dkps='docker ps'
alias dsp='docker system prune'
alias dcb='docker compose build'
alias dcu='docker compose up'
alias dcub='docker compose up --build'

# git
alias ghop='gh repo view --web'
alias gpm="git pull origin main"
alias gls="git log --pretty=format:\"%C(yellow)%h%Cred%d\\ %Creset%s%Cgreen\\ [%cn]\" --decorate"

# Some tmux-related shell aliases
# Attaches tmux to the last session; creates a new session if none exists.
alias t='tmux attach || tmux new-session'

# Attaches tmux to a session (example: ta portal)
alias ta='tmux a -t'

# Creates a new session
alias tn='tmux new'

# Lists all ongoing sessions
alias tl='tmux ls'

alias lg='lazygit'

alias aws="aws --ca-bundle=/Users/sankarraj/.ssh/zscaler.pem"

