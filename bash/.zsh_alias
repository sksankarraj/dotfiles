alias python=python3
alias pip=pip3

alias cd="z"

alias lg='lazygit'

alias c=clear
alias update="brew update"
alias upgrade="brew upgrade"

alias tf='terraform'
alias tfa='terraform apply'
alias tfc='terraform console'
alias tfd='terraform destroy'
alias tff='terraform fmt'
alias tfin='terraform init'
alias tfp='terraform plan'
alias tfay='terraform apply -auto-approve'
alias tfdy='terraform destroy -auto-approve'
alias tfinu='terraform init -upgrade'

alias aws="aws --ca-bundle=/Users/sankarraj/.ssh/zscaler.pem"
alias awslocal='aws --endpoint-url="http://localhost:4566"'

# Docker
alias dk='docker'
alias dkb='docker build'
alias dke='docker exec'
alias dkE='docker exec -e COLUMNS=`tput cols` -e LINES=`tput lines` -i -t'
alias dkh='docker history'
alias dki='docker images'
alias dkps='docker ps --format "table {{.Names}}\t{{.Image}}\t{{.Ports}}"'
alias dsp='docker system prune'
alias dcb='docker compose build'
alias dcu='docker compose up'
alias dcub='docker compose up --build'
alias dcd='docker compose down'

# git
alias ghop='gh repo view --web'
alias gpm="git pull origin main"
alias gls="git log --pretty=format:\"%C(yellow)%h%Cred%d\\ %Creset%s%Cgreen\\ [%cn]\" --decorate"

# Some tmux-related shell aliases
alias t='tmux attach || tmux new-session'
alias ta='tmux a -t'
alias tn='tmux new'
alias tl='tmux ls'

alias td='todo.sh'
alias tda='todo.sh add'
alias tdl='todo.sh list'
alias tdc='todo.sh done'
